{
  "name": "paseo-issue-automation",
  "version": "0.1.0",
  "description": "Repository-independent GitHub issue coding and serial ChatGPT PR-review automation for Paseo",
  "type": "module",
  "license": "MIT",
  "bin": {
    "paseo-issue-automation": "./bin/paseo-issue-automation.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "pack:check": "npm pack --dry-run",
    "manager": "node ./bin/paseo-issue-automation.mjs manager",
    "setup": "node ./bin/paseo-issue-automation.mjs setup",
    "start": "node ./bin/paseo-issue-automation.mjs start",
    "status": "node ./bin/paseo-issue-automation.mjs status"
  },
  "dependencies": {
    "playwright": "^1.61.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yajinni/Paseo-Issue-Automation.git"
  },
  "keywords": [
    "paseo",
    "github",
    "coding-agent",
    "automation",
    "pull-request-review",
    "playwright"
  ]
}
